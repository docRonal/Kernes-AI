{
  "openapi": "3.1.0",
  "info": {
    "title": "Autonomous CFO demo API",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "responses": {
          "200": {
            "description": "Process is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "const": "ok"
                    }
                  },
                  "required": [
                    "status"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/api/forecast": {
      "post": {
        "description": "Compute 14 end-of-day balances including start_date. Opening balance is before any start_date movement. Sum all dated movements through day 14. Ignore rows outside this window in the projection and return the original CSV rows in transactions. Report the first strictly negative end-of-day balance as a positive shortfall. Both move fields must be supplied together or omitted. If supplied, shift a positive transaction within the window to another date within that window in the scenario only. If omitted, scenario is null. When the baseline goes below zero, proposal is a credit facility with limit_minor = max(0, -min(baseline balances)). deepest_shortfall is the lowest baseline balance; the earliest day wins a tie. relevant_transaction_ids lists the window's rows, by date, up to the day the balance recovers from that deepest gap or the window's end. proposal is null when every baseline balance is zero or above. The scenario never changes the proposal.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/ForecastRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Computed forecast",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ForecastResponse"
                }
              }
            }
          },
          "422": {
            "description": "Invalid CSV, fields, transaction ID or scenario date. detail is a readable message, with the CSV line number where it applies."
          }
        }
      }
    },
    "/api/decision": {
      "post": {
        "description": "Simulate the user's decision on the proposed facility for the baseline from the forecast response. The server recalculates limit_minor from the baseline, so it always matches the proposal. Approved: each day uses up to limit_minor to cover a negative balance and reports what is still uncovered. Rejected: the facility is unused and the original gap stays uncovered. Balances are returned unchanged. Nothing is applied for, transferred or sent. The result is the same in demo and live modes.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DecisionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Simulated outcome",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DecisionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unknown decision, a baseline that isn't 14 consecutive days, or a baseline without a shortfall"
          }
        }
      }
    },
    "/api/advice": {
      "post": {
        "description": "Explain the baseline credit facility proposal with the model served on OpenShift AI and draft an editable payment reminder. Send the baseline and transactions from the forecast response. The server recalculates the proposal, gives the model only formatted facts, and rejects an answer whose EUR amounts don't match them. Demo mode returns demo/advice.example.json for the bundled baseline.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdviceRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Explanation and editable draft",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdviceResponse"
                }
              }
            }
          },
          "422": {
            "description": "Invalid request, or a baseline with no shortfall to explain"
          },
          "503": {
            "description": "The model is unavailable, timed out, or its explanation didn't match the calculated figures. The forecast and proposal stay valid."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Transaction": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f\\u2028\\u2029]*$"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "amount_minor": {
            "type": "integer",
            "minimum": -100000000000,
            "maximum": 100000000000
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f\\u2028\\u2029]*$"
          }
        },
        "required": [
          "id",
          "date",
          "amount_minor",
          "label"
        ],
        "additionalProperties": false
      },
      "Deficit": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "shortfall_minor": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "date",
          "shortfall_minor"
        ],
        "additionalProperties": false
      },
      "DailyBalance": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "balance_minor": {
            "type": "integer"
          }
        },
        "required": [
          "date",
          "balance_minor"
        ],
        "additionalProperties": false
      },
      "Forecast": {
        "type": "object",
        "properties": {
          "days": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DailyBalance"
            },
            "minItems": 14,
            "maxItems": 14,
            "description": "14 end-of-day balances on consecutive dates."
          },
          "first_deficit": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Deficit"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "days",
          "first_deficit"
        ],
        "additionalProperties": false
      },
      "ForecastRequest": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
            "format": "binary",
            "description": "UTF-8 CSV, at most 1 MB and 5,000 rows. Header id,date,amount_minor,label in any order. Unique IDs; ISO dates; signed integer grosz up to 100,000,000,000 in absolute value. Blank lines are ignored."
          },
          "starting_balance_minor": {
            "type": "integer"
          },
          "start_date": {
            "type": "string",
            "format": "date"
          },
          "move_transaction_id": {
            "type": "string"
          },
          "move_to_date": {
            "type": "string",
            "format": "date"
          }
        },
        "required": [
          "file",
          "starting_balance_minor",
          "start_date"
        ],
        "additionalProperties": false
      },
      "Proposal": {
        "type": "object",
        "description": "Credit facility proposed for a baseline shortfall. Amounts come from the calculation, never from the model.",
        "properties": {
          "limit_minor": {
            "type": "integer",
            "minimum": 1
          },
          "first_shortfall": {
            "$ref": "#/components/schemas/Deficit"
          },
          "deepest_shortfall": {
            "$ref": "#/components/schemas/Deficit"
          },
          "relevant_transaction_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "limit_minor",
          "first_shortfall",
          "deepest_shortfall",
          "relevant_transaction_ids"
        ],
        "additionalProperties": false
      },
      "EarlierPayment": {
        "type": "object",
        "description": "An incoming payment that would shrink the proposed facility if the client paid it by pay_by. Calculated, never from the model.",
        "properties": {
          "transaction_id": {
            "type": "string"
          },
          "pay_by": {
            "type": "string",
            "format": "date",
            "description": "The day before the first shortfall, or the first day of the forecast."
          },
          "limit_after_minor": {
            "type": "integer",
            "minimum": 0,
            "description": "Facility still needed if the payment arrives by pay_by."
          }
        },
        "required": [
          "transaction_id",
          "pay_by",
          "limit_after_minor"
        ],
        "additionalProperties": false
      },
      "ForecastResponse": {
        "type": "object",
        "properties": {
          "transactions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Transaction"
            }
          },
          "baseline": {
            "$ref": "#/components/schemas/Forecast"
          },
          "proposal": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Proposal"
              },
              {
                "type": "null"
              }
            ]
          },
          "earlier_payments": {
            "type": "array",
            "description": "Incoming payments due after the first shortfall that would lower the facility if paid earlier, best first. Empty without a shortfall.",
            "items": {
              "$ref": "#/components/schemas/EarlierPayment"
            }
          },
          "scenario": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Forecast"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "transactions",
          "baseline",
          "proposal",
          "earlier_payments",
          "scenario"
        ],
        "additionalProperties": false
      },
      "DecisionRequest": {
        "type": "object",
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "approved",
              "rejected"
            ]
          },
          "baseline": {
            "$ref": "#/components/schemas/Forecast"
          }
        },
        "required": [
          "decision",
          "baseline"
        ],
        "additionalProperties": false
      },
      "DecisionDay": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "balance_minor": {
            "type": "integer"
          },
          "facility_used_minor": {
            "type": "integer",
            "minimum": 0
          },
          "uncovered_minor": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "date",
          "balance_minor",
          "facility_used_minor",
          "uncovered_minor"
        ],
        "additionalProperties": false
      },
      "DecisionResponse": {
        "type": "object",
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "approved",
              "rejected"
            ]
          },
          "simulated": {
            "const": true
          },
          "limit_minor": {
            "type": "integer",
            "minimum": 1
          },
          "days": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DecisionDay"
            },
            "minItems": 14,
            "maxItems": 14
          },
          "largest_uncovered": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Deficit"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "decision",
          "simulated",
          "limit_minor",
          "days",
          "largest_uncovered"
        ],
        "additionalProperties": false
      },
      "AdviceRequest": {
        "type": "object",
        "description": "The baseline and original transactions from the forecast response. The server recalculates the proposal from them and sends only those calculated facts to the model.",
        "properties": {
          "baseline": {
            "$ref": "#/components/schemas/Forecast"
          },
          "transactions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/Transaction"
            },
            "maxItems": 5000
          }
        },
        "required": [
          "baseline",
          "transactions"
        ],
        "additionalProperties": false
      },
      "AdviceResponse": {
        "type": "object",
        "properties": {
          "explanation": {
            "type": "string",
            "minLength": 1,
            "description": "Model explanation of the proposal. Every EUR amount it cites was checked against the calculated figures, and it cites the proposed limit."
          },
          "email_draft": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Editable payment reminder for the first incoming payment after the shortfall starts. Null when there is none. The user sends it themselves."
          },
          "model": {
            "type": "string",
            "description": "Served model name, or 'demo sample' in demo mode."
          },
          "latency_ms": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ],
            "description": "Time spent on the model call. Null in demo mode."
          }
        },
        "required": [
          "explanation",
          "email_draft",
          "model",
          "latency_ms"
        ],
        "additionalProperties": false
      }
    }
  }
}
